#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 2
#define SCROLL 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        henkan {
            bindings = <&kp LC(LS(K))>;
            key-positions = <23 24>;
            layers = <0 1>;
        };

        muhenkan {
            bindings = <&kp LC(LS(S))>;
            key-positions = <15 14>;
            layers = <0 1>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
            layers = <0 1>;
        };

        remove_duplicates {
            bindings = <&remove_duplicates>;
            key-positions = <3 2>;
            layers = <1>;
        };

        merging {
            bindings = <&merging_cells>;
            key-positions = <48 47>;
            layers = <1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer1_en: to_layer1_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&mo 1>,
                <&macro_tap>,
                <&kp LC(LS(S))>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>;

            label = "TO_LAYER1_EN";
        };

        ime_tog: ime_on_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "IME_ON_OFF";
        };

        shift_click: shift_crick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&mkp LCLK>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFT_CRICK";
        };

        control_click: contolor_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_CONTROL &mkp LCLK>;

            label = "CONTOLOR_CLICK";
        };

        sort: transe_row_colum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(D) &kp S>;
            label = "TRANSE_ROW_COLUM";
        };

        remove_duplicates: choufuku {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp A &kp M>;
            label = "CHOUFUKU";
        };

        window_hold: window_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp W &kp F &kp F>;
            label = "WINDOW_HOLD";
        };

        merging_cells: merging_cells {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp H &kp M &kp C>;
            label = "MERGING_CELLS";
        };

        paste_formulas_only: paste_formulas_only {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp S &kp F &kp ENTER>;
            label = "PASTE_FORMULAS_ONLY";
        };

        transpose_and_paste: transpose_and_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp S &kp E &kp V &kp ENTER>;
            label = "TRANSPOSE_AND_PASTE";
        };

        paste_memo_only: paste_memo_only {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp S &kp C &kp ENTER>;
            label = "PASTE_MEMO_ONLY";
        };

        auto_calculation_on: auto_calculation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp M &kp X &kp A>;
            label = "AUTO_CALCULATION";
        };

        auto_calculation_off: auto_calculation_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp M &kp X &kp M>;
            label = "AUTO_CALCULATION_OFF";
        };

        name_change: name_change {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &kp F2>;
            label = "NAME_CHANGE";
        };

        sheet_delete: seet_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp L>;
            label = "SEET_DELETE";
        };

        double_zero: double_zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0 &kp NUMBER_0>;
            label = "DOUBLE_ZERO";
        };

        row_plus: row_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SPACE) &kp LC(KP_PLUS)>;
            label = "ROW_PLUS";
        };

        row_minus: row_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SPACE) &kp LC(KP_MINUS)>;
            label = "ROW_MINUS";
        };

        colum_plus: colum_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LC(KP_PLUS)>;
            label = "COLUM_PLUS";
        };

        colum_minus: colum_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LC(KP_MINUS)>;
            label = "COLUM_MINUS";
        };

        row_copy: row_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SPACE) &kp LC(C)>;
            label = "ROW_COPY";
        };

        row_cut: row_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SPACE) &kp LC(X)>;
            label = "ROW_CUT";
        };

        colum_copy: colum_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LC(C)>;
            label = "COLUM_COPY";
        };

        colum_cut: colum_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LC(X)>;
            label = "COLUM_CUT";
        };

        vlookup: vlookup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp I &kp F &kp N &kp A &kp LEFT_PARENTHESIS &kp V &kp L &kp O &kp O &kp K &kp U &kp P &kp LEFT_PARENTHESIS>;
            label = "VLOOKUP";
        };

        sumif: sumif {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp S &kp U &kp M &kp I &kp F &kp LEFT_PARENTHESIS>;
            label = "SUMIF";
        };

        sumifs: sumifs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp S &kp U &kp M &kp I &kp F &kp S &kp LEFT_PARENTHESIS>;
            label = "SUMIFS";
        };

        round: round {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp R &kp O &kp U &kp N &kp D &kp LEFT_PARENTHESIS &kp LEFT_PARENTHESIS>;
            label = "ROUND";
        };

        roundup: roundup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp R &kp O &kp U &kp N &kp D &kp U &kp P &kp LEFT_PARENTHESIS &kp LEFT_PARENTHESIS>;
            label = "ROUNDUP";
        };

        rounddown: rounddown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp R &kp O &kp U &kp N &kp D &kp D &kp O &kp W &kp N &kp LEFT_PARENTHESIS &kp LEFT_PARENTHESIS>;
            label = "ROUNDDOWN";
        };

        sum: sum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp S &kp U &kp M &kp LEFT_PARENTHESIS>;
            label = "SUM";
        };

        sumproduct: sumproduct {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp S &kp U &kp M &kp P &kp R &kp O &kp D &kp U &kp C &kp T &kp LEFT_PARENTHESIS>;
            label = "SUMPRODUCT";
        };

        mid: mid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp M &kp I &kp D &kp LEFT_PARENTHESIS>;
            label = "MID";
        };

        text: text {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp T &kp E &kp X &kp T &kp LEFT_PARENTHESIS>;
            label = "TEXT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        lt_en: lt_en {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to_layer1_en>, <&kp>;
        };

        ht_kp_ime: ht_kp_ime {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&ime_tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            label = "HT_KP_IME";
        };

        ht_sc_rmkp: ht_sc_rmkp {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&shift_click>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            label = "HT_SC_RMKP";
        };

        ht_msc: ht_msc {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&msc>, <&msc>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            label = "HT_MSC";
            quick-tap-ms = <200>;
        };

        tap_rclk: tap_rclk {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&ht_sc_rmkp 0 RCLK>, <&control_click>, <&sheet_delete>;

            tapping-term-ms = <250>;
            label = "TAP_RCLK";
        };

        tap_up: tap_up {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            label = "TAP_UP";
            bindings =
                <&mt HOME UP_ARROW>,
                <&mt LC(V) LC(LS(V))>,
                <&paste_formulas_only>,
                <&transpose_and_paste>,
                <&paste_memo_only>;
        };

        tap_down: tap_down {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            label = "TAP_DOWN";
            bindings =
                <&mt END DOWN_ARROW>,
                <&mt LC(LS(L)) LC(LS(DOWN_ARROW))>,
                <&sort>;
        };

        tap_left: tap_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            label = "TAP_LEFT";
            bindings =
                <&mt LS(HOME) LEFT_ARROW>,
                <&kp F2>,
                <&remove_duplicates>;
        };

        tap_right: tap_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            label = "TAP_RIGHT";
            bindings =
                <&mt LS(END) RIGHT_ARROW>,
                <&kp LC(LS(RIGHT_ARROW))>,
                <&window_hold>;
        };

        tap_row: tap_row {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&row_copy>, <&row_cut>, <&row_plus>, <&row_minus>;

            tapping-term-ms = <250>;
            label = "TAP_ROW";
        };

        tap_colum: tap_colum {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings =
                <&colum_copy>,
                <&colum_cut>,
                <&colum_plus>,
                <&colum_minus>;

            tapping-term-ms = <250>;
            label = "TAP_COLUM";
        };

        tap_row_colum_group: tap_row_colum_group {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings =
                <&mt LC(SPACE) LS(SPACE)>,
                <&kp LA(LS(RIGHT_ARROW))>,
                <&kp LA(LS(LEFT_ARROW))>;

            tapping-term-ms = <250>;
            label = "TAP_ROW_COLUM_GROUP";
        };

        tap_calcu: tap_calcu {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&auto_calculation_off>, <&auto_calculation_on>;

            tapping-term-ms = <250>;
            label = "TAP_CALCU";
        };

        tap_equal: tap_equal {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&sum>, <&sumproduct>;

            tapping-term-ms = <250>;
            label = "TAP_EQUAL";
        };

        tap_lookup: tap_lookup {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&vlookup>, <&sumif>, <&sumifs>;

            tapping-term-ms = <250>;
            label = "TAP_LOOKUP";
        };

        tap_round: tap_round {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&roundup>, <&rounddown>, <&round>;

            tapping-term-ms = <250>;
            label = "TAP_ROUND";
        };

        tap_mid_text: tap_mid_text {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mid>, <&text>;

            tapping-term-ms = <250>;
            label = "TAP_MID_TEXT";
        };

        tap_num_enter: tap_num_enter {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mt (F9) LC(Z)>, <&mt (LC(S)) LG(D)>;

            tapping-term-ms = <250>;
            label = "TAP_NUM_ENTER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&ht_kp_ime CAPSLOCK 0     &kp Q         &kp W              &kp E                   &kp R          &kp T                                                           &kp UP_ARROW                         &kp Y  &kp U  &kp I                   &lt 3 O                &mt AT_SIGN P
&kp TAB                   &kp A         &kp S              &kp D                   &kp F          &kp G        &kp C_MUTE       &ht_msc SCRL_DOWN SCRL_UP         &kp DOWN_ARROW                       &kp H  &kp J  &kp K                   &kp L                  &mt KP_MINUS MINUS
&kp LSHFT                 &kp Z         &kp X              &kp C                   &kp V          &kp B        &lt 6 ESCAPE     &kp LEFT_ARROW                    &kp RIGHT_ARROW                      &kp N  &kp M  &mt LEFT_BRACKET COMMA  &mt RIGHT_BRACKET DOT  &mt SEMICOLON SLASH
&mt (LEFT_CONTROL) LC(C)  &kp LEFT_GUI  &mt (LG(E)) LG(D)  &mt (LEFT_ALT) LA(TAB)  &kp BACKSPACE  &lt 1 SPACE  &kp LG(LS(S))    &mt (LA(LEFT_ARROW)) LC(PAGE_UP)  &mt (LA(RIGHT_ARROW)) LC(PAGE_DOWN)                                        &kp F7                 &lt_en 0 ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM_SYMBOL {
            bindings = <
&mt (LC(NUMBER_1)) LC(LS(S))  &tap_lookup    &mt KP_NUMLOCK NUMBER_7       &mt KP_DIVIDE NUMBER_8  &mt KP_ASTERISK NUMBER_9  &mt LC(KP_MINUS) KP_MINUS                                              &mt GRAVE SINGLE_QUOTE  &mt LESS_THAN LEFT_PARENTHESIS  &mt GREATER_THAN RIGHT_PARENTHESIS  &mkp LCLK  &tap_up    &tap_rclk
&trans                        &tap_round     &mt F4 NUMBER_4               &kp NUMBER_5            &kp NUMBER_6              &mt LC(KP_PLUS) KP_PLUS    &trans        &ht_msc SCRL_RIGHT SCRL_LEFT  &mt BACKSLASH DOLLAR    &kp PERCENT                     &kp AMPERSAND                       &tap_left  &tap_down  &tap_right
&trans                        &tap_mid_text  &kp NUMBER_1                  &kp NUMBER_2            &kp NUMBER_3              &tap_equal                 &tap_calcu    &tap_row_colum_group          &mt EQUAL EXCLAMATION   &kp DOUBLE_QUOTES               &kp POUND                           &trans     &trans     &mt (LA(F4)) LC(W)
&mt (LEFT_CONTROL) LC(X)      &trans         &mt LC(KP_NUMBER_0) NUMBER_0  &double_zero            &mt COMMA DOT             &trans                     &trans        &tap_colum                    &tap_row                                                                                               &kp F12    &tap_num_enter
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                  &trans        &trans
            >;
        };
    };
};
